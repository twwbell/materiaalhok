# Baserow (server-side only)
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=            # database token (Settings > Database tokens), needs create/read/update/delete on the 4 tables
BASEROW_TABLE_CATEGORIEEN=
BASEROW_TABLE_MATERIAAL=
BASEROW_TABLE_LENINGEN=
BASEROW_TABLE_LEENREGELS=

# Mail. SMTP is used when SMTP_HOST is set (Ziggo: smtp.ziggo.nl, port 587, user = full address,
# MAIL_FROM must be that address). Otherwise Resend if RESEND_API_KEY is set, else mails are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM="Materiaalhok <materiaalhok@example.nl>"
ADMIN_EMAIL=beheerder@example.nl   # reply-to for mails + daily overdue overview

# Cron (Vercel sends this as Authorization: Bearer <secret>)
CRON_SECRET=

# Max days ahead the return date may be chosen
MAX_DAYS=14

# Only for scripts/setup-baserow.mjs (creating tables needs a JWT, a database token can't do that)
BASEROW_EMAIL=
BASEROW_PASSWORD=
BASEROW_DATABASE_ID=
